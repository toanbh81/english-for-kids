AZURE_SPEECH_KEY=your-key
AZURE_SPEECH_REGION=southeastasia

# --- Supabase (Phase 11, optional) ------------------------------------------
# Only the serverless functions in api/ read these. The app works with all of
# them missing. SUPABASE_SERVICE_ROLE is a REAL secret (it bypasses every
# security policy): keep it here and in the Vercel project settings, never in
# client/ and never in a document. See supabase/README.md.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=your-key
# Optional: set the same value in Vercel to require it on the daily /api/ping cron.
CRON_SECRET=
