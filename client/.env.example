# Base URL of the token API. Leave empty to use the Vite dev/preview proxy (same origin).
# Set it only when the client is served from somewhere the proxy does not cover,
# e.g. VITE_API_BASE=http://192.168.10.4:8787
VITE_API_BASE=

# --- Supabase (Phase 11, optional) ------------------------------------------
# Leave both empty and the app runs exactly as before, with no cloud at all.
# Both values are PUBLIC by design: they are compiled into the browser bundle,
# and Row Level Security is what actually protects the data. The service-role
# key is the secret one and belongs in server/.env — never here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
