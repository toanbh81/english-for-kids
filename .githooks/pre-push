#!/usr/bin/env bash
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per ref being pushed
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue            # branch deletion
  if [ "$rsha" = "$zero" ]; then range="$(git merge-base --fork-point HEAD 2>/dev/null || git rev-list --max-parents=0 HEAD | tail -1)..$lsha"
  else range="$rsha..$lsha"; fi
  bash "$root/scripts/check-secrets.sh" range "$range" || status=1
done
exit $status
